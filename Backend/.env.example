# MFC Youth Web Backend - Supabase configuration
# Copy this file to Backend/.env.local for LOCAL development only.
# NEVER commit Backend/.env.local or real secret values.

# Supabase Project URL from Project -> Connect / Settings -> API Keys
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Current Supabase API keys (recommended)
# Publishable key is low-privilege and is used server-side here only for Auth sign-in.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# SECRET: backend only. This bypasses Row Level Security.
SUPABASE_SECRET_KEY=sb_secret_YOUR_KEY

# Server-only Servant Leader registration verification code.
ADMIN_REGISTRATION_CODE=CHANGE_THIS_TO_A_PRIVATE_VALUE

# Compatibility only: the backend can still read these older names if needed.
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
