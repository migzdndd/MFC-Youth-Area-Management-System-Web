# Neon PostgreSQL connection created by the Vercel/Neon integration.
# Keep the real value ONLY in Vercel Environment Variables or Backend/.env.local.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Server-only Servant Leader registration code.
ADMIN_REGISTRATION_CODE=YOUR_ADMIN_REGISTRATION_CODE

# Optional: exact production frontend origin for state-changing request checks.
# Example: https://mfc-youth-area-management-system.vercel.app
FRONTEND_ORIGIN=

# Optional session policy overrides.
SESSION_HOURS=12
REMEMBER_SESSION_DAYS=30
