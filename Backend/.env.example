# Supabase project settings. Configure these as Vercel Environment Variables.
# NEVER commit a real SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Server-only Servant Leader registration code.
# Set this in Vercel and Backend/.env.local; never expose it in Frontend code.
ADMIN_REGISTRATION_CODE=YOUR_ADMIN_REGISTRATION_CODE
